# ─────────────────────────────────────────────────────────────────────────────
# Live SAP S/4HANA configuration — copy values from discover_sap_rdp.bat output
# Rename this file to .env (or merge into your existing .env)
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic LLM (required for real NLP — get from console.anthropic.com) ────
ANTHROPIC_API_KEY=sk-ant-api03-...
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.0

# ── SAP S/4HANA Connection ────────────────────────────────────────────────────
# Get these values from the output of scripts/discover_sap_rdp.bat

# Hostname or IP of the SAP system
# - If running inside RDP: use the hostname shown by `hostname` command inside RDP
# - If SAP is on company network: use the server hostname from SAPUILandscape.xml
# - If behind a reverse proxy / SAP Web Dispatcher: use that URL
SAP_HOST=s4h-dev.mycompany.com

# ICM HTTP/HTTPS port (check SMICM → Goto → Services inside SAP)
# Common values:
#   44300 = HTTPS, system number 00
#   44301 = HTTPS, system number 01
#    8000 = HTTP,  system number 00
#    8443 = HTTPS (custom / SAP Web Dispatcher)
#     443 = HTTPS (load balancer / cloud)
SAP_HTTP_PORT=44300

# true if port is HTTPS (44300, 443, 8443), false if HTTP (8000, 8080)
SAP_HTTPS=true

# 3-digit SAP client (visible on the SAP logon screen, e.g. 100, 110, 400)
SAP_CLIENT=100

# OData base path — this is always the same on standard S/4HANA
SAP_ODATA_BASE_PATH=/sap/opu/odata/sap

# Authentication
SAP_AUTH_TYPE=basic
SAP_USERNAME=NLP_QUERY           # SAP user with OData read access (see notes below)
SAP_PASSWORD=YourSAPPassword1!

# System type and language
SAP_SYSTEM_TYPE=S4HANA
SAP_LANGUAGE=EN

# ── RFC (disabled — using OData instead, no SAP NW RFC SDK needed) ────────────
SAP_RFC_ENABLED=false

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO

# IMPORTANT: Set to false to use live SAP data
MOCK_SAP=false

# ─────────────────────────────────────────────────────────────────────────────
# SAP User Authorisation Notes (no admin needed to CREATE — ask your Basis team)
# ─────────────────────────────────────────────────────────────────────────────
#
# The SAP user (NLP_QUERY above) needs these authorisation objects:
#
#  Object          Field    Value      Purpose
#  ─────────────────────────────────────────────────────────────────────
#  S_SERVICE       SRV_NAME *          OData service access
#  S_RFC           RFC_TYPE FUGR       RFC function group access
#  S_RFC           RFC_NAME *          (restrict to needed FGs in production)
#  F_BKPF_BUK      BUKRS    *          Read FI documents (all company codes)
#  F_BKPF_KOA      KOART    *          Read all account types
#  M_BEST_BSA      BSART    *          Read purchasing documents
#  V_VBAK_VKO      VKORG    *          Read sales orders
#  C_AFKO_AWK      WERKS    *          Read production orders
#  M_MSEG_WMB      WERKS    *          Read goods movements
#  B_USERSTAT      STATOBJ  *          Read stock (optional)
#
# Minimum role to ask Basis team for:
#   Z_NLP_READONLY — a display-only role with the above objects
#
# Or assign standard SAP roles:
#   SAP_BC_DWB_WBDISPLAY    — generic display
#   /IWFND/RT_GW_USER        — Gateway/OData user
# ─────────────────────────────────────────────────────────────────────────────
