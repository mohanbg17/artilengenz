# ── Anthropic / LLM ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0          # deterministic for query generation

# ── SAP Connection (OData / HTTP) ──────────────────────────────────────────────
SAP_HOST=my-s4-system.example.com
SAP_HTTP_PORT=443
SAP_HTTPS=true
SAP_CLIENT=100
SAP_ODATA_BASE_PATH=/sap/opu/odata/sap
SAP_AUTH_TYPE=basic            # basic | oauth2 | saml
SAP_USERNAME=nlp_query_user
SAP_PASSWORD=secret
# OAuth2 (when SAP_AUTH_TYPE=oauth2)
SAP_TOKEN_URL=https://my-s4-system.example.com/sap/bc/sec/oauth2/token
SAP_CLIENT_ID=nlp_client
SAP_CLIENT_SECRET=secret

# ── SAP RFC (optional, requires SAP NW RFC SDK) ────────────────────────────────
SAP_RFC_HOST=10.0.0.1
SAP_RFC_SYSNR=00
SAP_RFC_LOGON_GROUP=
SAP_RFC_ENABLED=false

# ── SAP System Type ────────────────────────────────────────────────────────────
SAP_SYSTEM_TYPE=S4HANA          # S4HANA | ECC
SAP_LANGUAGE=EN

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development             # development | production
LOG_LEVEL=INFO
MOCK_SAP=true                   # true = use mock data (no live SAP needed)
