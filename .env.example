# ─── Database backend ─────────────────────────────────────────────────
# Choose: "postgres" (default, runs locally via docker-compose) or "snowflake"
DB_ENGINE=postgres

# ─── Postgres (used when DB_ENGINE=postgres) ──────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=artilegenz
PG_PASSWORD=artilegenz_local_dev
PG_DATABASE=sap_errors

# ─── Snowflake (used when DB_ENGINE=snowflake) ────────────────────────
SF_ACCOUNT=
SF_USER=
SF_PRIVATE_KEY_PATH=
SF_PRIVATE_KEY_PASSPHRASE=
SF_WAREHOUSE=ARTILEGENZ_WH
SF_DATABASE=SAP_ERRORS
SF_RAW_SCHEMA=RAW
SF_INTEL_SCHEMA=INTEL
SF_ROLE=ARTILEGENZ_INTEL

# ─── Ingest endpoint auth ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARTILEGENZ_INGEST_TOKEN=

# ─── AI services (only required when classifier runs) ─────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_CRITIQUE_MODEL=claude-opus-4-7

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_DIM=1024

PINECONE_API_KEY=
PINECONE_INDEX=sap-errors
PINECONE_NAMESPACE=corpus_v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── Classifier tuning ────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70
TOP_K_DEFAULT=8
TOP_K_RETRY=20
MAX_RETRIES=1

# ─── API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ─── IDoc OData extractor (extractors.idoc) ───────────────────────────
# OData v2 base URL for the SAP standard service exposing IDoc data.
# Common defaults: API_IDOC_SRV (S/4HANA), IDOC_DISPLAY_SRV (older releases),
# or a custom Z-service over a CDS view (see docs/idoc_mvp.md).
IDOC_ODATA_BASE_URL=
IDOC_SAP_USERNAME=
IDOC_SAP_PASSWORD=
IDOC_SAP_HOST=
IDOC_SAP_SYSNR=00
IDOC_SAP_CLIENT=100

# Override only if your service uses non-standard entity-set or field names
# IDOC_ENTITY_HEADER=Idoc
# IDOC_ENTITY_STATUS=IdocStatusRecord
# IDOC_ENTITY_SEGMENT=IdocSegment
# IDOC_FIELD_DOCNUM=IdocNumber
# IDOC_FIELD_STATUS=Status
# IDOC_FIELD_CREATED=CreationDateTime
# IDOC_FIELD_DIRECTION=Direction
# IDOC_FIELD_MESTYP=MessageType
# IDOC_FIELD_IDOCTP=BasicType
# IDOC_FIELD_SNDPRN=SenderPartnerNumber
# IDOC_FIELD_RCVPRN=ReceiverPartnerNumber
# IDOC_FIELD_CLIENT=Client

# Where the poller posts records (re-uses ARTILEGENZ_INGEST_TOKEN above)
IDOC_INGEST_URL=http://localhost:8000/ingest/errors
